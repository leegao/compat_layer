                "VK_KHR_8bit_storage": 1,
                "VK_KHR_16bit_storage": 1,
                "VK_KHR_shader_float16_int8": 1,
                "VK_KHR_shader_atomic_int64": 1,
                "VK_ANDROID_external_memory_android_hardware_buffer": 1,
                "VK_KHR_external_fence": 1,

{
    "$schema": "https://schema.khronos.org/vulkan/profiles-0.8.1-224.json#",
    "capabilities": {
        "baseline": {
            "extensions": {
                "VK_EXT_external_memory_dma_buf": 1,
                "VK_EXT_external_memory_host": 1,
                "VK_KHR_timeline_semaphore": 1,
                "VK_KHR_swapchain": 1,
                "VK_KHR_image_format_list": 1,
                "VK_KHR_maintenance2": 1,
